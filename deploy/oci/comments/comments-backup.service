[Unit]
Description=Comments (Comentario) SQLite backup

[Service]
Type=oneshot
User=comments
Group=comments
ExecStart=/usr/local/lib/comments/comments-backup.sh
TimeoutStartSec=10min
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/srv/comments/data
ReadWritePaths=/srv/comments/backups
InaccessiblePaths=/srv/comments/deploy
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
