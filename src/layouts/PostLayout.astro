---
/**
 * 글 상세 레이아웃 (NOR-16, NOR-17).
 *
 * 헤딩 계층: 글 제목이 `h1`, 본문 헤딩은 `h2` 부터 쓰는 것을 전제로 한다.
 *
 * 파생 데이터(목차·읽기 시간·ISO 날짜)는 여기서 계산하지 않고 `derivePostDetail` 이 만든
 * {@link PostDetail} 을 받는다. 같은 값을 Phase 7(JSON-LD)이 다시 쓰기 때문이다 —
 * 표시용 계산을 템플릿에 묻어두면 구조화 데이터와 조용히 어긋난다. 읽기 시간을
 * `<time datetime="PT3M">` 으로 내보내는 것도 같은 이유다(JSON-LD `timeRequired` 와 같은 값).
 *
 * 메타(NOR-27)도 같은 원칙이다 — `og:type=article` 과 `article:published_time` /
 * `article:modified_time` 을 `BaseLayout` 에 넘기되, 시각은 {@link PostDetail} 의 ISO 값을
 * **재사용**한다. 화면은 `isUpdated` 가 false 면 수정일을 감추지만 OG 는 감추지 않는다 —
 * `updatedAt` 은 스키마 필수 필드라 항상 실재하고, 크롤러에게는 "발행일과 같음"이 더 정확한
 * 정보이기 때문이다(spec NOR-27 결정 7).
 *
 * 확장 지점: 본문 뒤 `<slot name="after-content">`. NOR-18 의 시리즈 내비게이션이 여기 들어온다.
 * 레이아웃은 그 안에 무엇이 오는지 알지 못한다 — 시리즈 내비게이션을 렌더할지 말지는
 * `buildSeriesNav`(ADR 0011)가 판단하고, 레이아웃은 자리만 내준다.
 */
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { formatKoreanDate } from '../lib/date';
import { categoryPath, seriesPath, tagPath } from '../lib/routes';
import { toSlug } from '../lib/slug';
import type { Post, Series } from '../lib/content';
import type { PostDetail } from '../lib/post-detail';
import { buildArticleJsonLd, buildBreadcrumbJsonLd } from '../lib/json-ld';

interface Props {
  post: Post;
  /** 목차·읽기 시간·ISO 날짜. `derivePostDetail(...)` 의 결과를 그대로 넘긴다. */
  detail: PostDetail;
  /**
   * 글이 시리즈에 속할 때 그 시리즈 정의. **헤더의 소속 표시(이름 + 링크) 전용**이다.
   * 이전/다음·목록·진행도는 `after-content` 슬롯의 `SeriesNav` 가 그린다(NOR-18).
   */
  series?: Series | undefined;
}

const { post, detail, series } = Astro.props;
const { title, description, category, tags, publishedAt, updatedAt, draft } = post.data;
const { toc, readingTime, publishedISO, updatedISO, isUpdated } = detail;
const url = `https://gze1206.net/blog/${post.data.slug}`;
const jsonLd = [
  buildArticleJsonLd({ title, description, url, published: publishedISO, modified: updatedISO }),
  buildBreadcrumbJsonLd([
    { name: '홈', url: 'https://gze1206.net/' },
    { name: '블로그', url: 'https://gze1206.net/blog' },
    { name: title, url },
  ]),
];
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  article={{ publishedTime: publishedISO, modifiedTime: updatedISO }}
  jsonLd={jsonLd}
>
  <main id="main-content" class="mx-auto max-w-3xl px-4 py-10 sm:py-14">
    <article data-pagefind-body>
      <header class="mb-8 border-b border-gray-200 pb-6 dark:border-gray-800">
        {
          draft && (
            <p class="mb-3 inline-block rounded bg-amber-100 px-2 py-1 text-sm font-semibold text-amber-900 dark:bg-amber-900 dark:text-amber-100">
              초안 — 개발 서버에서만 보입니다
            </p>
          )
        }
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
        <p class="mt-3 text-gray-600 dark:text-gray-400">{description}</p>

        <div
          class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-gray-500 dark:text-gray-400"
        >
          <time datetime={publishedISO}>{formatKoreanDate(publishedAt)}</time>
          {
            isUpdated && (
              <span>
                (수정 <time datetime={updatedISO}>{formatKoreanDate(updatedAt)}</time>)
              </span>
            )
          }
          <span>읽는 시간 <time datetime={readingTime.iso}>{readingTime.label}</time></span>
          <a href={categoryPath(toSlug(category))} class="rounded hover:underline">{category}</a>
        </div>

        {
          series && (
            <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">
              시리즈{' '}
              <a href={seriesPath(series.data.slug)} class="rounded font-medium hover:underline">
                {series.data.name}
              </a>
            </p>
          )
        }
      </header>

      <TableOfContents entries={toc} />

      <div class="post-body">
        <slot />
      </div>

      <slot name="after-content" />

      <footer class="mt-12 border-t border-gray-200 pt-6 dark:border-gray-800">
        <h2 class="text-sm font-semibold text-gray-500 dark:text-gray-400">태그</h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {
            tags.map((tag) => (
              <li>
                <a
                  href={tagPath(toSlug(tag))}
                  class="inline-block rounded-full bg-gray-100 px-2.5 py-0.5 text-sm text-gray-700 hover:bg-gray-200 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700"
                >
                  #{tag}
                </a>
              </li>
            ))
          }
        </ul>
      </footer>
    </article>
  </main>
</BaseLayout>
