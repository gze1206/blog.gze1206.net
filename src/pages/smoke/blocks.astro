---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('posts', 'custom-blocks-smoke-test');
if (!entry) throw new Error('custom-blocks-smoke-test entry not found');
const { Content } = await render(entry);
---

<BaseLayout title="커스텀 블럭 스모크 테스트">
  <main id="main-content" class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-2xl font-bold">{entry.data.title}</h1>
    <p class="mt-2 text-sm text-gray-500">{entry.data.description}</p>
    <hr class="my-8" />
    <Content />
  </main>
</BaseLayout>
