---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const mdEntry = await getEntry('posts', 'math-mermaid-smoke-test');
if (!mdEntry) throw new Error('math-mermaid-smoke-test entry not found');
const { Content: MdContent } = await render(mdEntry);

const mdocEntry = await getEntry('posts', 'math-mermaid-smoke-test-mdoc');
if (!mdocEntry) throw new Error('math-mermaid-smoke-test-mdoc entry not found');
const { Content: MdocContent } = await render(mdocEntry);
---

<BaseLayout title="수식·다이어그램 스모크 테스트">
  <main id="main-content" class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-2xl font-bold">수식·다이어그램 스모크 테스트</h1>
    <p class="text-muted mt-2 text-sm">
      .md와 .mdoc 양쪽 경로에서 KaTeX 수식과 Mermaid 다이어그램이 동작하는지 확인합니다.
    </p>

    <section class="mt-12">
      <h2 class="text-xl font-semibold">Markdown (.md) 경로</h2>
      <hr class="my-4" />
      <MdContent />
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-semibold">Markdoc (.mdoc) 경로</h2>
      <hr class="my-4" />
      <MdocContent />
    </section>
  </main>
</BaseLayout>
