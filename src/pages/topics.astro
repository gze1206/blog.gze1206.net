---
/**
 * 탐색 (NOR-135, NOR-137, NOR-152).
 *
 * 한 페이지에서 세 가지 관점을 준다: 큰 분류(카테고리), 관계(지도), 세부 색인(태그).
 * 지도는 **보조 수단**이다. 지도가 뜨지 않아도 위아래의 정적 목록으로 모든 분류에 갈 수 있다.
 */
import TaxonomyCategoryList from '../components/TaxonomyCategoryList.astro';
import TaxonomyTagList from '../components/TaxonomyTagList.astro';
import TaxonomyMap, { type TaxonomyNodeDetail } from '../islands/TaxonomyMap';
import ListLayout from '../layouts/ListLayout.astro';
import { getCategoryGroups, getTagGroups, getVisiblePosts } from '../lib/content';
import { formatKoreanDate } from '../lib/date';
import { categoryPath, postPath, tagPath } from '../lib/routes';
import { buildTaxonomyGraph } from '../lib/taxonomy-graph';
import { buildTaxonomyMap } from '../lib/taxonomy-map';

const [categories, tags, posts] = await Promise.all([
  getCategoryGroups(),
  getTagGroups(),
  getVisiblePosts(),
]);
const map = buildTaxonomyMap(buildTaxonomyGraph(posts));

/** 지도에서 노드를 골랐을 때 보여 줄 것. 화면이 다시 계산하지 않도록 여기서 만들어 넘긴다. */
const ARTICLE_LIMIT = 3;
const details: Record<string, TaxonomyNodeDetail> = {};

for (const group of categories) {
  details[`category:${group.slug}`] = {
    label: group.label,
    kindLabel: '카테고리',
    href: categoryPath(group.slug),
    postCount: group.posts.length,
    articles: group.posts.slice(0, ARTICLE_LIMIT).map((post) => ({
      title: post.data.title,
      href: postPath(post.data.slug),
      meta: `${post.data.category} · ${formatKoreanDate(post.data.publishedAt)}`,
    })),
  };
}

for (const group of tags) {
  details[`tag:${group.slug}`] = {
    label: group.label,
    kindLabel: '태그',
    href: tagPath(group.slug),
    postCount: group.posts.length,
    articles: group.posts.slice(0, ARTICLE_LIMIT).map((post) => ({
      title: post.data.title,
      href: postPath(post.data.slug),
      meta: `${post.data.category} · ${formatKoreanDate(post.data.publishedAt)}`,
    })),
  };
}
---

<ListLayout
  title="탐색"
  description="카테고리와 태그의 관계로 gze1206.net의 글을 탐색합니다."
  eyebrow="탐색"
  heading="무엇을 다뤘고, 무엇과 이어지는가"
  lead="큰 주제는 카테고리로, 세부 주제는 태그로 봅니다. 가운데 지도는 둘이 글에서 얼마나 자주 만나는지를 보여 줍니다."
>
  <TaxonomyCategoryList categories={categories} />
  <TaxonomyMap client:load map={map} details={details} />
  <TaxonomyTagList tags={tags} />
</ListLayout>
