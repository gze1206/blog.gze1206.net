---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getVisiblePosts } from '../lib/content';

// 루트 페이지의 서사·포트폴리오는 NOR-21~23 범위다. 여기서는 최신 글로 가는 길만 낸다.
const recentPosts = (await getVisiblePosts()).slice(0, 3);
---

<BaseLayout
  title="gze1206.net"
  description="게임 개발과 웹·서버 개발을 기록하는 gze1206의 개인 블로그입니다."
>
  <main id="main-content" class="mx-auto max-w-3xl px-4 py-16">
    <section aria-labelledby="about-heading">
      <p class="text-accent text-sm font-semibold tracking-wide">GAME · WEB · SERVER</p>
      <h1 id="about-heading" class="mt-3 text-4xl font-bold tracking-tight">gze1206</h1>
      <p class="mt-4 text-lg leading-8 text-gray-700 dark:text-gray-300">
        4년 이상 게임 클라이언트·서버와 웹 서비스를 개발해 온 소프트웨어 개발자입니다. 플레이 경험과
        운영 환경 모두에서 오래 유지되는 구조를 고민합니다.
      </p>

      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        <section aria-labelledby="experience-heading">
          <h2 id="experience-heading" class="text-xl font-bold">경험</h2>
          <ul class="mt-3 list-disc space-y-2 pl-5 text-gray-700 dark:text-gray-300">
            <li>MMORPG 클라이언트·서버 개발과 일본 라이브 서비스 운영</li>
            <li>플레이어블 광고, 개발 도구, 성능 최적화</li>
            <li>개인 프로젝트·외주에서의 서버와 웹 개발</li>
          </ul>
        </section>
        <section aria-labelledby="stack-heading">
          <h2 id="stack-heading" class="text-xl font-bold">주요 기술</h2>
          <p class="mt-3 text-gray-700 dark:text-gray-300">
            C#, Unity, ASP.NET Core, TypeScript, Node.js, React, Astro, PostgreSQL, Redis, Docker,
            Cloudflare
          </p>
        </section>
      </div>
    </section>

    <section class="mt-14" aria-labelledby="recent-posts-heading">
      <h2 id="recent-posts-heading" class="text-2xl font-bold">최근 글</h2>
      {
        recentPosts.length === 0 ? (
          <p class="mt-4 text-gray-600 dark:text-gray-400">아직 발행된 글이 없습니다.</p>
        ) : (
          <div>
            {recentPosts.map((post) => (
              <PostCard post={post} headingLevel={3} />
            ))}
          </div>
        )
      }
      <p class="mt-8">
        <a href="/blog" class="rounded font-semibold underline">블로그 글 전체 보기</a>
      </p>
    </section>
  </main>
</BaseLayout>
