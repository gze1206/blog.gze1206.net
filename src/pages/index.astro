---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getProfile, getVisiblePosts } from '../lib/content';
import { getVisibleExperiences } from '../lib/experience';
import { buildPersonJsonLd } from '../lib/json-ld';
import { getCollection } from 'astro:content';
import InteractiveCanvas from '../islands/InteractiveCanvas';

// 루트 페이지의 서사·포트폴리오는 NOR-21~23 범위다. 여기서는 최신 글로 가는 길만 낸다.
const [allPosts, portfolio, profile, experiences] = await Promise.all([
  getVisiblePosts(),
  getCollection('portfolio'),
  getProfile(),
  getVisibleExperiences(),
]);
const recentPosts = allPosts.slice(0, 3);
---

<BaseLayout
  title="gze1206.net"
  description="게임 개발과 웹·서버 개발을 기록하는 gze1206의 개인 블로그입니다."
  jsonLd={buildPersonJsonLd('https://gze1206.net/')}
>
  <main id="main-content" class="mx-auto max-w-3xl px-4 py-16">
    <section class="interactive-canvas-shell" aria-labelledby="about-heading">
      <InteractiveCanvas client:visible />
      <div class="relative z-10">
        <p class="text-accent text-sm font-semibold tracking-wide">{profile.data.headline}</p>
        <h1 id="about-heading" class="mt-3 text-4xl font-bold tracking-tight">
          {profile.data.name}
        </h1>
        <p class="mt-4 text-lg leading-8 text-gray-700 dark:text-gray-300">
          {profile.data.introduction}
        </p>

        <div class="mt-8 grid gap-6 sm:grid-cols-2">
          <section aria-labelledby="stack-heading">
            <h2 id="stack-heading" class="text-xl font-bold">주요 기술</h2>
            <ul class="mt-3 flex flex-wrap gap-2" aria-label="주요 기술">
              {
                profile.data.skills.map((skill) => (
                  <li class="rounded bg-gray-100 px-2 py-1 text-sm dark:bg-gray-800">{skill}</li>
                ))
              }
            </ul>
          </section>
          {
            experiences.length > 0 && (
              <section aria-labelledby="experience-heading">
                <h2 id="experience-heading" class="text-xl font-bold">
                  경력
                </h2>
                <ul class="mt-3 space-y-3 text-gray-700 dark:text-gray-300">
                  {experiences.map((experience) => (
                    <li>
                      <p class="font-semibold">
                        {experience.data.organization} · {experience.data.role}
                      </p>
                      <p class="text-sm">{experience.data.period}</p>
                      <ul class="mt-1 list-disc space-y-1 pl-5">
                        {experience.data.highlights.map((highlight) => (
                          <li>{highlight}</li>
                        ))}
                      </ul>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }
        </div>
      </div>
    </section>

    <section class="mt-14" aria-labelledby="portfolio-heading">
      <h2 id="portfolio-heading" class="text-2xl font-bold">프로젝트</h2>
      <div class="mt-5 grid gap-4">
        {
          portfolio.map((entry) => (
            <article class="border-border bg-surface rounded-lg border p-5">
              <h3 class="text-xl font-bold">{entry.data.title}</h3>
              <p class="mt-2 text-gray-700 dark:text-gray-300">{entry.data.summary}</p>
              <ul class="mt-3 flex flex-wrap gap-2" aria-label={`${entry.data.title} 기술 스택`}>
                {entry.data.stack.map((technology) => (
                  <li class="rounded bg-gray-100 px-2 py-1 text-sm dark:bg-gray-800">
                    {technology}
                  </li>
                ))}
              </ul>
              <div class="mt-4 flex flex-wrap gap-3">
                {entry.data.links
                  .flatMap((link) => Object.entries(link))
                  .map(([kind, url]) => (
                    <a
                      href={url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="rounded font-semibold underline"
                    >
                      {kind}
                    </a>
                  ))}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="mt-14" aria-labelledby="recent-posts-heading">
      <h2 id="recent-posts-heading" class="text-2xl font-bold">최근 글</h2>
      {
        recentPosts.length === 0 ? (
          <p class="mt-4 text-gray-600 dark:text-gray-400">아직 발행된 글이 없습니다.</p>
        ) : (
          <div>
            {recentPosts.map((post) => (
              <PostCard post={post} headingLevel={3} />
            ))}
          </div>
        )
      }
      <p class="mt-8">
        <a href="/blog" class="rounded font-semibold underline">블로그 글 전체 보기</a>
      </p>
    </section>
  </main>
</BaseLayout>
