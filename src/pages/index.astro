---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getVisiblePosts } from '../lib/content';
import { buildPersonJsonLd } from '../lib/json-ld';
import { getCollection } from 'astro:content';

// 루트 페이지의 서사·포트폴리오는 NOR-21~23 범위다. 여기서는 최신 글로 가는 길만 낸다.
const recentPosts = (await getVisiblePosts()).slice(0, 3);
const portfolio = await getCollection('portfolio');
---

<BaseLayout
  title="gze1206.net"
  description="게임 개발과 웹·서버 개발을 기록하는 gze1206의 개인 블로그입니다."
  jsonLd={buildPersonJsonLd('https://gze1206.net/')}
>
  <main id="main-content" class="home-page mx-auto max-w-5xl px-4 py-12 sm:py-16">
    <section class="home-hero" aria-labelledby="about-heading">
      <div class="home-hero__decoration" aria-hidden="true"></div>
      <div class="home-hero__content">
        <p class="home-eyebrow">GAME · WEB · SERVER</p>
        <h1 id="about-heading" class="home-title">gze1206</h1>
        <p class="home-lede">
          4년 이상 게임 클라이언트·서버와 웹 서비스를 개발해 온 소프트웨어 개발자입니다. 플레이
          경험과 운영 환경 모두에서 오래 유지되는 구조를 고민합니다.
        </p>
        <p class="home-summary">
          C#을 주력으로 Unity와 ASP.NET Core를 다루며, 필요에 따라 TypeScript·Node.js·React와
          데이터베이스·배포 환경까지 이어서 만듭니다. 게임의 기능을 구현하는 일과 운영 중인 서비스를
          안정적으로 고치는 일 사이를 오가며 쌓은 경험을 이곳에 기록합니다.
        </p>

        <div class="home-hero__details">
          <section class="home-detail" aria-labelledby="experience-heading">
            <h2 id="experience-heading" class="home-detail__heading">경험</h2>
            <ul class="home-detail__list">
              <li>MMORPG 클라이언트·서버 개발과 일본 라이브 서비스 운영</li>
              <li>플레이어블 광고, 개발 도구, 성능 최적화</li>
              <li>개인 프로젝트·외주에서의 서버와 웹 개발</li>
            </ul>
          </section>
          <section class="home-detail" aria-labelledby="stack-heading">
            <h2 id="stack-heading" class="home-detail__heading">주요 기술</h2>
            <ul class="home-tech-list" aria-label="주요 기술 목록">
              {
                [
                  'C#',
                  'Unity',
                  'ASP.NET Core',
                  'TypeScript',
                  'Node.js',
                  'React',
                  'Astro',
                  'PostgreSQL',
                  'Redis',
                  'Docker',
                  'Cloudflare',
                ].map((technology) => <li class="home-tech-token">{technology}</li>)
              }
            </ul>
          </section>
        </div>
      </div>
    </section>

    <section class="home-section" aria-labelledby="portfolio-heading">
      <div class="home-section__heading">
        <p class="home-section__eyebrow">SELECTED WORK</p>
        <h2 id="portfolio-heading" class="home-section__title">프로젝트</h2>
      </div>
      <div class="home-project-grid">
        {
          portfolio.map((entry) => (
            <article class="home-project-card">
              <h3 class="home-project-card__title">{entry.data.title}</h3>
              <p class="home-project-card__summary">{entry.data.summary}</p>
              <ul
                class="home-tech-list home-project-card__stack"
                aria-label={`${entry.data.title} 기술 스택`}
              >
                {entry.data.stack.map((technology) => (
                  <li class="home-tech-token">{technology}</li>
                ))}
              </ul>
              <div class="home-project-card__links">
                {entry.data.links
                  .flatMap((link) => Object.entries(link))
                  .map(([kind, url]) => (
                    <a
                      href={url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="home-project-card__link"
                    >
                      {kind}
                    </a>
                  ))}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="home-section home-section--posts" aria-labelledby="recent-posts-heading">
      <div class="home-section__heading">
        <p class="home-section__eyebrow">WRITING</p>
        <h2 id="recent-posts-heading" class="home-section__title">최근 글</h2>
      </div>
      {
        recentPosts.length === 0 ? (
          <p class="home-empty-state">아직 발행된 글이 없습니다.</p>
        ) : (
          <div class="home-recent-posts">
            {recentPosts.map((post) => (
              <PostCard post={post} headingLevel={3} />
            ))}
          </div>
        )
      }
      <p class="home-section__action">
        <a href="/blog" class="home-text-link">블로그 글 전체 보기</a>
      </p>
    </section>
  </main>
</BaseLayout>
