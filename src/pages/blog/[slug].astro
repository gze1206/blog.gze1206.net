---
/**
 * 글 상세 (NOR-16). URL 은 **프론트매터 slug** 를 쓴다(파일명 기반 `entry.id` 가 아니다).
 *
 * 경로 목록을 `getVisiblePosts()` 에서 받으므로, 프로덕션 빌드에서는 draft 글의
 * 페이지 자체가 생성되지 않는다 — 목록에서 숨기는 것만으로는 URL 을 아는 사람에게 그대로 보인다.
 */
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getSeriesById, getVisiblePosts, type Post, type Series } from '../../lib/content';
import { derivePostDetail } from '../../lib/post-detail';

export const getStaticPaths = (async () => {
  const [posts, seriesById] = await Promise.all([getVisiblePosts(), getSeriesById()]);

  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: {
      post,
      // 참조 무결성은 `assertSeriesIntegrity` 가 보장하므로 여기서 미존재는 일어나지 않는다.
      series: post.data.series === undefined ? undefined : seriesById.get(post.data.series),
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  series: Series | undefined;
}

const { post, series } = Astro.props;

/**
 * `headings` 는 **렌더러가 실제로 붙인 헤딩 id** 다(`.md` 는 rehype, `.mdoc` 은 Markdoc
 * `nodes.heading` 이 만든다). 목차를 본문 원문에서 다시 파싱하지 않고 이 값을 쓰기 때문에
 * 목차 링크가 본문 앵커와 어긋날 수 없다.
 */
const { Content, headings } = await render(post);
const detail = derivePostDetail({
  publishedAt: post.data.publishedAt,
  updatedAt: post.data.updatedAt,
  body: post.body,
  headings,
});
---

<PostLayout post={post} detail={detail} series={series}>
  <Content />
</PostLayout>
