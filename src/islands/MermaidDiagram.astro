<script>
  async function initMermaid() {
    const preBlocks = document.querySelectorAll<HTMLPreElement>('pre[data-language="mermaid"]');
    if (preBlocks.length === 0) return;

    const { default: mermaid } = await import('mermaid');

    const isDark = document.documentElement.classList.contains('dark');
    mermaid.initialize({
      startOnLoad: false,
      theme: isDark ? 'dark' : 'default',
      securityLevel: 'strict',
    });

    const containers: { el: HTMLDivElement; source: string }[] = [];

    for (const pre of preBlocks) {
      const source = pre.textContent?.trim() ?? '';
      if (!source) continue;

      const container = document.createElement('div');
      container.className = 'mermaid-container';
      container.setAttribute('data-rendered', 'false');
      container.innerHTML = '<span class="mermaid-loading">다이어그램 로딩 중…</span>';
      pre.replaceWith(container);
      containers.push({ el: container, source });
    }

    async function renderAll() {
      for (const { el, source } of containers) {
        try {
          const id = `mermaid-${crypto.randomUUID().slice(0, 8)}`;
          const { svg } = await mermaid.render(id, source);
          el.innerHTML = svg;
          el.setAttribute('data-rendered', 'true');
          el.setAttribute('role', 'img');
          el.setAttribute('aria-label', 'Mermaid 다이어그램');
        } catch {
          const pre = document.createElement('pre');
          const code = document.createElement('code');
          code.textContent = source;
          pre.appendChild(code);
          el.replaceChildren(pre);
          el.setAttribute('data-rendered', 'true');
        }
      }
    }

    await renderAll();

    window.addEventListener('themechange', () => {
      mermaid.initialize({
        startOnLoad: false,
        theme: document.documentElement.classList.contains('dark') ? 'dark' : 'default',
        securityLevel: 'strict',
      });
      renderAll();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMermaid);
  } else {
    initMermaid();
  }
</script>
