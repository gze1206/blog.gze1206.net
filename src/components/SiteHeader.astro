---
/**
 * 사이트 공통 헤더 (NOR-16).
 *
 * 랜드마크(`header` > `nav`)를 제공하고, 현재 섹션에 `aria-current="page"` 를 준다.
 * 시각 디자인 확정은 NOR-24(베이스 테마) 몫이라 여기서는 최소한만 둔다.
 */
import ThemeToggle from '../islands/ThemeToggle';
import SearchPalette from '../islands/SearchPalette';
import { aboutPath, portfolioPath, topicsPath } from '../lib/routes';
import BrandMark from './BrandMark.astro';

// 시리즈는 글에서 자연스럽게 이어지므로 상단에서 뺐다. 푸터에서 접근할 수 있다.
const NAV_ITEMS = [
  { href: '/blog', label: '글' },
  { href: aboutPath(), label: '소개' },
  { href: portfolioPath(), label: '포트폴리오' },
  { href: topicsPath(), label: '탐색' },
] as const;

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

/**
 * 정확히 그 페이지면 `page`, 그 아래 하위 경로면 `true`(현재 섹션).
 * 하위 글에서까지 `page` 를 주면 "지금 이 페이지"라는 뜻이 흐려진다.
 */
function currentState(href: string): 'page' | 'true' | undefined {
  if (pathname === href) return 'page';
  return pathname.startsWith(`${href}/`) ? 'true' : undefined;
}
---

<header class="border-border border-b">
  <div class="site-shell flex flex-wrap items-center gap-x-6 gap-y-2 py-4">
    <a href="/" class="site-brand">
      <span class="site-brand__mark"><BrandMark size={19} weight="bold" /></span>
      <span class="site-brand__word">NORU</span>
    </a>
    <nav aria-label="주요">
      <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a href={item.href} aria-current={currentState(item.href)} class="site-nav__link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <SearchPalette client:load />
    <ThemeToggle client:load />
  </div>
</header>
