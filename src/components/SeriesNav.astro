---
/**
 * 시리즈 내비게이션 블록 (NOR-18, ADR 0011). 글 상세 본문 뒤(`slot="after-content"`)에 붙는다.
 *
 * - **JS 없는 정적 마크업**이다. 접기는 `<details>/<summary>` 로, 브라우저 기본 동작만 쓴다
 *   (키보드: Tab → Enter/Space). 열림 여부는 렌더 시점에 정해져 CLS 가 없다.
 * - `nav` 가 `null` 이면 아무것도 렌더하지 않는다. **판단은 호출부가 아니라 `buildSeriesNav`
 *   하나가 한다** (시리즈 미소속 / 노출 대상 1편 → `null`).
 * - 시리즈 이름·링크는 여기서 다시 보여주지 않는다. 상세 헤더가 이미 소속을 표시한다(NOR-16).
 * - 목록·이전/다음·진행도는 모두 `nav` 하나(= 노출 대상 목록 하나)에서 나온다. 여기서 다시
 *   거르거나 세지 않는다.
 */
import { postPath } from '../lib/routes';
import type { Post } from '../lib/content';
import { shouldExpandSeriesList, type SeriesNavigation } from '../lib/series-nav';

interface Props {
  /** `buildSeriesNav(...)` 의 결과. `null` 이면 블록을 렌더하지 않는다. */
  nav: SeriesNavigation<Post> | null;
}

const { nav } = Astro.props;
---

{
  nav !== null && (
    <section
      aria-labelledby="series-nav-heading"
      class="border-border bg-surface-sunken mt-12 rounded-lg border px-5 py-4"
    >
      <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
        <h2 id="series-nav-heading" class="text-body text-sm font-semibold">
          이 시리즈의 글
        </h2>
        <p class="text-muted text-sm">
          {/* 보이는 것은 짧게, 읽히는 것은 완전하게. 같은 정보를 두 번 읽지 않도록 한쪽만 노출한다. */}
          <span aria-hidden="true">
            {nav.position} / {nav.total}
          </span>
          <span class="sr-only">
            전체 {nav.total}편 중 {nav.position}번째 글
          </span>
        </p>
      </div>

      <details class="mt-3" open={shouldExpandSeriesList(nav.total)}>
        <summary class="text-muted cursor-pointer rounded text-sm hover:underline">
          전체 {nav.total}편 · 연재 순서
        </summary>
        <ol class="mt-3 space-y-1.5 text-sm">
          {nav.items.map((item) => (
            <li class="flex gap-2">
              <span class="text-muted w-10 shrink-0 tabular-nums">{item.position}편</span>
              {item.isCurrent ? (
                /* 자기 자신으로 가는 링크는 혼란스럽다. 링크 대신 현재 위치임을 표시한다. */
                <span aria-current="true" class="text-foreground font-semibold">
                  {item.post.data.title}
                  <span
                    aria-hidden="true"
                    class="bg-surface-sunken text-body ml-2 rounded px-1.5 py-0.5 text-xs font-medium"
                  >
                    현재
                  </span>
                </span>
              ) : (
                <a href={postPath(item.post.data.slug)} class="text-body rounded hover:underline">
                  {item.post.data.title}
                </a>
              )}
            </li>
          ))}
        </ol>
      </details>

      {/* 없는 쪽은 자리 자체를 만들지 않는다 — 아무 데도 가지 않는 비활성 버튼을 두지 않는다. */}
      <nav aria-label="시리즈 내비게이션" class="mt-4 grid gap-2 sm:grid-cols-2">
        {nav.previous !== undefined && (
          <a
            href={postPath(nav.previous.data.slug)}
            rel="prev"
            class="border-border bg-surface hover:border-border-strong rounded-md border px-4 py-3"
          >
            <span class="text-muted block text-xs">
              <span aria-hidden="true">←</span> 이전 편
            </span>
            {/* 접근 가능한 이름에 제목이 들어간다 — "이전"만으로는 어디로 가는지 알 수 없다. */}
            <span class="text-foreground mt-0.5 block font-medium">{nav.previous.data.title}</span>
          </a>
        )}
        {nav.next !== undefined && (
          <a
            href={postPath(nav.next.data.slug)}
            rel="next"
            class="border-border bg-surface hover:border-border-strong rounded-md border px-4 py-3 sm:col-start-2 sm:text-right"
          >
            <span class="text-muted block text-xs">
              다음 편 <span aria-hidden="true">→</span>
            </span>
            <span class="text-foreground mt-0.5 block font-medium">{nav.next.data.title}</span>
          </a>
        )}
      </nav>
    </section>
  )
}
