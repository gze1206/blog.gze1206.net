---
/**
 * `{% github repo="owner/name" /%}` — GitHub 레포 카드(설명·스타·언어).
 *
 * 메타는 **빌드타임에** GitHub REST API 로 가져와 정적 HTML 로 굽는다(ADR 0008).
 * - 작성자가 `description` 을 명시하면 fetch 자체를 건너뛴다.
 * - repo 형식 위반·404·rate limit·네트워크 오류는 전부 `owner/name` 링크로 폴백한다.
 */
import { DAY_MS, HOUR_MS, withCache } from '../../lib/disk-cache';
import { fetchGitHubRepo, parseRepoSlug, type GitHubRepoMeta } from '../../lib/github-repo';

/** 스타 수는 자주 변하므로 북마크보다 짧게 잡는다. */
const REPO_TTL_MS = DAY_MS;

interface Props {
  repo: string;
  description?: string;
  stars?: number;
  language?: string;
}

const { repo, description, stars, language } = Astro.props;

const slug = parseRepoSlug(repo);
if (!slug) {
  console.warn(`[blocks] github repo 형식이 올바르지 않습니다 — "${repo}". 폴백으로 렌더합니다.`);
}

const hasExplicitDescription = (description?.trim().length ?? 0) > 0;

let meta: GitHubRepoMeta | null = null;
if (slug && !hasExplicitDescription) {
  meta = await withCache(
    { namespace: 'gh', key: `${slug.owner}/${slug.name}`, ttlMs: REPO_TTL_MS, failTtlMs: HOUR_MS },
    () => fetchGitHubRepo(slug),
  );
}

const fullName = meta?.fullName ?? (slug ? `${slug.owner}/${slug.name}` : repo.trim());
const repoUrl = meta?.url ?? (slug ? `https://github.com/${slug.owner}/${slug.name}` : undefined);

// 명시 속성이 fetch 결과를 이긴다.
const cardDescription = description?.trim() || meta?.description;
const cardStars = stars ?? meta?.stars;
const cardLanguage = language?.trim() || meta?.language;
const cardForks = meta?.forks;

const state = hasExplicitDescription ? 'explicit' : meta ? 'fetched' : 'fallback';

// repo 형식이 어긋나면 목적지를 지어내지 않는다 — 링크 없이 카드 내용만 남긴다.
const Tag = repoUrl ? 'a' : 'div';
const linkProps = repoUrl
  ? ({ href: repoUrl, target: '_blank', rel: 'noopener noreferrer' } as const)
  : {};

const compact = new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 });

const GITHUB_MARK =
  'M12 1.5a10.5 10.5 0 0 0-3.32 20.47c.53.1.72-.23.72-.5v-1.8c-2.92.63-3.54-1.4-3.54-1.4-.48-1.22-1.17-1.54-1.17-1.54-.95-.65.07-.64.07-.64 1.06.08 1.61 1.09 1.61 1.09.94 1.6 2.46 1.14 3.06.87.1-.68.37-1.14.67-1.4-2.33-.27-4.78-1.17-4.78-5.19 0-1.15.41-2.08 1.09-2.82-.11-.27-.47-1.34.1-2.79 0 0 .88-.28 2.89 1.08a10 10 0 0 1 5.26 0c2-1.36 2.88-1.08 2.88-1.08.58 1.45.22 2.52.11 2.79.68.74 1.09 1.67 1.09 2.82 0 4.03-2.46 4.92-4.8 5.18.38.33.71.97.71 1.96v2.9c0 .28.19.61.72.5A10.5 10.5 0 0 0 12 1.5z';
const STAR_MARK = 'M12 3.2l2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1L3.2 9.6l6.1-.9z';
const FORK_MARK =
  'M7 4.8a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm10 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zM7 8.8v1.7a2.5 2.5 0 0 0 2.5 2.5h5A2.5 2.5 0 0 0 17 10.5V8.8M12 13v2.2m0 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4z';
---

<Tag class="block-github" data-block="github" data-block-state={state} {...linkProps}>
  <span class="block-github-head">
    <svg
      class="block-github-mark"
      viewBox="0 0 24 24"
      width="20"
      height="20"
      aria-hidden="true"
      focusable="false"
    >
      <path fill="currentColor" d={GITHUB_MARK}></path>
    </svg>
    <span class="block-github-name">{fullName}</span>
  </span>

  {cardDescription && <span class="block-github-desc">{cardDescription}</span>}

  {
    (cardStars !== undefined || cardForks !== undefined || cardLanguage) && (
      <span class="block-github-meta">
        {cardStars !== undefined && (
          <span class="block-github-stat">
            <svg
              viewBox="0 0 24 24"
              width="14"
              height="14"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d={STAR_MARK} />
            </svg>
            <span class="sr-only">스타 </span>
            {compact.format(cardStars)}
          </span>
        )}
        {cardForks !== undefined && (
          <span class="block-github-stat">
            <svg
              viewBox="0 0 24 24"
              width="14"
              height="14"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <path d={FORK_MARK} />
            </svg>
            <span class="sr-only">포크 </span>
            {compact.format(cardForks)}
          </span>
        )}
        {cardLanguage && (
          <span class="block-github-stat">
            <span class="sr-only">주 언어 </span>
            {cardLanguage}
          </span>
        )}
      </span>
    )
  }
</Tag>
