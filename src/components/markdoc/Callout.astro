---
/**
 * `{% callout type="warning" title="주의" %} … {% /callout %}`
 *
 * 의미를 **색으로만** 전달하지 않는다(WCAG 1.4.1): 타입마다 실루엣이 다른 아이콘을 두고,
 * 커스텀 title 을 쓸 때도 타입 라벨을 스크린 리더용으로 남긴다.
 * 대비비는 라이트/다크 모두 AA(4.5:1) 이상 — 팔레트는 global.css 참고.
 */

export type CalloutType = 'note' | 'info' | 'tip' | 'success' | 'warning' | 'danger';

interface CalloutStyle {
  label: string;
  /** 24x24 뷰박스 기준 stroke 경로. 타입마다 실루엣이 확실히 달라야 한다. */
  paths: readonly string[];
}

const CIRCLE = 'M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0';

const CALLOUTS: Record<CalloutType, CalloutStyle> = {
  note: {
    label: '참고',
    paths: ['M5 3.5h14v17H5z', 'M8.5 8.5h7', 'M8.5 12h7', 'M8.5 15.5h4'],
  },
  info: {
    label: '정보',
    paths: [CIRCLE, 'M12 11v5.5', 'M12 7.6h.01'],
  },
  tip: {
    label: '팁',
    paths: [
      'M12 3a6 6 0 0 0-3.6 10.8c.5.4.8 1 .9 1.6l.1.6h5.2l.1-.6c.1-.6.4-1.2.9-1.6A6 6 0 0 0 12 3z',
      'M9.5 18.5h5',
      'M10.5 21h3',
    ],
  },
  success: {
    label: '성공',
    paths: [CIRCLE, 'M8 12.4l2.6 2.6L16 9.6'],
  },
  warning: {
    label: '주의',
    paths: [
      'M12 3.8 2.7 19.2a1.5 1.5 0 0 0 1.3 2.3h16a1.5 1.5 0 0 0 1.3-2.3L12 3.8z',
      'M12 9.5v4.5',
      'M12 17.6h.01',
    ],
  },
  danger: {
    label: '위험',
    paths: [
      'M8.6 2.5h6.8L21.5 8.6v6.8L15.4 21.5H8.6L2.5 15.4V8.6z',
      'M9.5 9.5l5 5',
      'M14.5 9.5l-5 5',
    ],
  },
};

interface Props {
  type?: CalloutType;
  title?: string;
}

const { type = 'note', title } = Astro.props;
const style = CALLOUTS[type] ?? CALLOUTS.note;
const heading = title?.trim();
---

<aside class="block-callout" data-callout={type} role="note">
  <p class="block-callout-head">
    <svg
      class="block-callout-icon"
      viewBox="0 0 24 24"
      width="20"
      height="20"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      {style.paths.map((d) => <path d={d} />)}
    </svg>
    <span class="block-callout-label">
      {
        heading ? (
          <Fragment>
            <span class="sr-only">{style.label}: </span>
            {heading}
          </Fragment>
        ) : (
          style.label
        )
      }
    </span>
  </p>
  <div class="block-callout-body"><slot /></div>
</aside>
