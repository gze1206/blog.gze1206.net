---
interface Props {
  url: string;
  title?: string;
  description?: string;
  image?: string;
}

const { url, title, description, image } = Astro.props;
---

<div class="markdoc-bookmark" data-url={url}>
  {image && <img src={image} alt="" />}
  <div>
    <a href={url} target="_blank" rel="noopener noreferrer">{title ?? url}</a>
    {description && <p>{description}</p>}
  </div>
</div>
