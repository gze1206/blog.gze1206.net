{
  "name": "gze1206-net",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev:blog": "pnpm --filter @gze1206/blog dev",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:workbench": "pnpm --filter @gze1206/workbench dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "e2e": "pnpm -r --if-present e2e",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm boundaries",
    "coverage": "pnpm -r --if-present coverage",
    "boundaries": "node packages/repo-tools/src/cli/boundaries.ts",
    "spec:check": "node packages/repo-tools/src/cli/spec-check.ts",
    "tdd:evidence": "node packages/repo-tools/src/cli/tdd-evidence.ts"
  },
  "devDependencies": {
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
