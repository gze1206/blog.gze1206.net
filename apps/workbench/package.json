{
  "name": "@gze1206/workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsx watch src/server/index.ts\"",
    "dev:web": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "build": "tsc -b && vite build && tsup",
    "start": "node dist/server/index.js",
    "e2e": "playwright test",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@gze1206/theme": "workspace:*",
    "@hono/node-server": "^2.1.0",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.1",
    "@markdoc/markdoc": "catalog:",
    "diff": "8.0.4",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.1",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-markdown": "^2.1.2",
    "pretendard": "1.3.9",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sharp": "^0.35.3",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@gze1206/config": "workspace:*",
    "@gze1206/content-contract": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "catalog:",
    "@types/mdast": "^4.0.4",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "catalog:",
    "concurrently": "^9.2.1",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.3.0",
    "tailwindcss": "catalog:",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "^8.2.1",
    "vitest": "catalog:"
  },
  "files": [
    "dist",
    "workspace-seed"
  ]
}
