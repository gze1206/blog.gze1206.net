{
  "name": "@gze1206/workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsx watch src/server/index.ts\"",
    "dev:web": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "build": "tsc -b && vite build && tsup src/server/index.ts --format esm --platform node --target node22 --out-dir dist/server --clean false",
    "start": "node dist/server/index.js",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.1",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-markdown": "^2.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "^2.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.0"
  },
  "files": [
    "dist",
    "workspace-seed"
  ]
}
