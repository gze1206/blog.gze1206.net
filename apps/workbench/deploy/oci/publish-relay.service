[Unit]
Description=Workbench publish relay (outbox -> content/* branch)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# 컨테이너(workbench)·백업(workbench-backup)과 다른 계정이다. deploy key 는 이 계정만 가진다.
User=workbench-relay
Group=workbench-relay
Environment=HOME=/var/lib/workbench-relay
Environment=RELAY_SSH_KEY=/var/lib/workbench-relay/.ssh/blog_deploy
ExecStart=/usr/local/lib/workbench/publish-relay.sh
TimeoutStartSec=5min
UMask=0077
# 잠금 디렉터리를 쥔 채 죽으면 다음 실행이 막힌다. 시작할 때 남은 잠금을 지운다(oneshot 이라 겹치지 않는다).
ExecStartPre=/bin/rm -rf /var/lib/workbench-relay/.lock

# outbox(workbench, 0700)는 읽기만 한다.
AmbientCapabilities=CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/srv/workbench/private-workspace/.workbench/publish-outbox
InaccessiblePaths=/srv/workbench/deploy /srv/workbench/workspace.git /srv/workbench/backups -/srv/comments -/etc/shadow -/etc/gshadow -/etc/ssh/ssh_host_ed25519_key -/etc/ssh/ssh_host_rsa_key -/etc/ssh/ssh_host_ecdsa_key -/var/lib/docker -/var/lib/tailscale -/etc/docker
ReadWritePaths=/var/lib/workbench-relay
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
