# 공개 댓글 서버 설정 (NOR-32). 이 파일을 `.env` 로 복사해 실제 값을 넣는다.
# `.env` 는 저장소에 넣지 않는다. 파일 권한은 0600, 소유자는 서비스 계정으로 둔다.

# 이미지 digest. 태그가 아니라 digest 로 고정한다.
#   docker buildx imagetools inspect lizheming/waline:latest --format '{{.Manifest.Digest}}'
#   docker buildx imagetools inspect cloudflare/cloudflared:latest --format '{{.Manifest.Digest}}'
WALINE_DIGEST=sha256:a3c87cb50fdb3aa786d73ac7afed492811d5dbc217866b12f3d5a4eda5c5e4bc
CLOUDFLARED_DIGEST=sha256:0aa26e284f05e6c77ae375b8c9c11d9eb6a448fb7bcd8d40f31cb6176189eb38

# 데이터. SQLite 파일이 여기 생긴다. 이 디렉터리 하나가 유일한 영속 상태다.
WALINE_DATA_DIR=/srv/comments/data
WALINE_UID=10002
WALINE_GID=10002

TZ=Asia/Seoul
WALINE_SITE_NAME=gze1206.net
WALINE_SITE_URL=https://gze1206.net
# 댓글 위젯이 실려도 되는 도메인. 쉼표로 여러 개. 여기 없는 페이지의 요청은 거부된다.
WALINE_SECURE_DOMAINS=gze1206.net,www.gze1206.net

# 관리자. 이 주소로 가입한 계정이 관리자가 된다.
WALINE_AUTHOR_EMAIL=you@example.com

# 세션 서명 키. 길고 무작위인 값으로 두고 공유하지 않는다.
#   openssl rand -base64 48
WALINE_JWT_TOKEN=change-me

# 익명 댓글의 방어선. IP 당 최소 간격(초)과 스팸 판정, 그리고 첫 노출 전 승인.
WALINE_IPQPS=60
WALINE_AKISMET_KEY=false
WALINE_COMMENT_AUDIT=true

# Cloudflare Tunnel 토큰. 대시보드에서 터널을 만들고 발급한다.
CLOUDFLARE_TUNNEL_TOKEN=change-me
