---
/**
 * About (NOR-156).
 *
 * 홈은 입구라 소개를 한 줄로 끝낸다. 그보다 긴 이야기 — 어떤 일을 어떻게 하는 사람인지,
 * 어디에서 무엇을 만들었는지, 연락할 방법 — 은 여기에 모은다.
 *
 * 경력을 별도 페이지로 두었더니 같은 이야기가 두 곳에 나뉘었다(NOR-160). 소개를 읽은
 * 사람이 바로 이어서 볼 것이므로 한 화면에 둔다. 목록은 접혀 있어 길이를 늘리지 않는다.
 *
 * 읽은 책은 푸터에만 두었더니 아무도 지나가지 않았다(NOR-188). 무엇을 읽는 사람인지는
 * 소개의 일부이므로, 요즘 읽는 것 몇 권을 여기에 두고 전체 책장으로 보낸다.
 *
 * 외부 프로필은 **링크로만** 건다. 배지 이미지를 렌더 시점에 불러오면 남의 서버 사정이
 * 이 페이지의 속도와 안정성이 된다(master 블로그가 그랬다).
 */
import ListLayout from '../layouts/ListLayout.astro';
import { spineTitle, spineTone } from '../lib/book-shelf';
import { getVisibleBooks } from '../lib/books';
import { getProfile } from '../lib/content';
import { getVisibleExperiences } from '../lib/experience';
import { booksPath, portfolioPath } from '../lib/routes';

const [profile, experiences, books] = await Promise.all([
  getProfile(),
  getVisibleExperiences(),
  getVisibleBooks(),
]);
/** 목록은 이미 "읽는 중 먼저, 그다음 최근 순"이다. 여기서는 앞에서 몇 권만 떼어 온다. */
const recentBooks = books.slice(0, 3);
const paragraphs = profile.data.about.length > 0 ? profile.data.about : [profile.data.introduction];
---

<ListLayout
  title="소개"
  description={`${profile.data.name}(gze1206)의 소개와 연락처입니다.`}
  eyebrow="소개"
  heading={profile.data.name}
  lead={profile.data.headline}
>
  <div class="about">
    <section class="about__body" aria-labelledby="about-intro-heading">
      <h2 id="about-intro-heading" class="sr-only">소개</h2>
      {paragraphs.map((paragraph) => <p>{paragraph}</p>)}

      <p class="about__more">
        <a href={portfolioPath()} class="home-text-link">포트폴리오 보기 →</a>
      </p>
    </section>

    <aside class="about__side">
      <section aria-labelledby="about-skills-heading">
        <h2 id="about-skills-heading" class="about__side-heading">주로 쓰는 것</h2>
        <ul class="portfolio-card__stack">
          {profile.data.skills.map((skill) => <li class="stack-token">{skill}</li>)}
        </ul>
      </section>

      {
        recentBooks.length > 0 && (
          <section aria-labelledby="about-reading-heading">
            <h2 id="about-reading-heading" class="about__side-heading">
              요즘 읽는 것
            </h2>
            <ul class="about__reading">
              {recentBooks.map((book) => (
                <li>
                  <a href={booksPath()}>
                    {book.data.cover ? (
                      <img
                        class="about__reading-cover"
                        src={book.data.cover.src}
                        alt=""
                        width={book.data.cover.width}
                        height={book.data.cover.height}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span
                        class={`about__reading-cover book-card__blank book-card__blank--t${spineTone(book.data.title)}`}
                      >
                        <span class="about__reading-spine">{spineTitle(book.data.title)}</span>
                      </span>
                    )}
                    <span class="about__reading-body">
                      <span class="about__reading-title">{book.data.title}</span>
                      <span class="about__reading-author">{book.data.authors[0]}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
            <p class="about__more">
              <a href={booksPath()} class="home-text-link">
                책장 전체 보기 →
              </a>
            </p>
          </section>
        )
      }

      {
        profile.data.links.length > 0 && (
          <section aria-labelledby="about-links-heading">
            <h2 id="about-links-heading" class="about__side-heading">
              연락과 프로필
            </h2>
            <ul class="about__links">
              {profile.data.links.map((link) => (
                <li>
                  <a href={link.url} rel="me noopener noreferrer">
                    <span>{link.label}</span>
                    {link.handle && <span class="about__handle">{link.handle}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </aside>

    {
      experiences.length > 0 && (
        <section class="about__career" aria-labelledby="about-career-heading">
          <h2 id="about-career-heading" class="taxonomy-section__title">
            경력
          </h2>
          <ol class="career-timeline">
            {experiences.map((experience) => (
              <li>
                <details class="career-entry">
                  <summary class="career-entry__summary">
                    <span class="career-entry__period">{experience.data.period}</span>
                    <span class="career-entry__organization">{experience.data.organization}</span>
                    <span class="career-entry__role">{experience.data.role}</span>
                  </summary>
                  <ul class="career-entry__highlights">
                    {experience.data.highlights.map((highlight) => (
                      <li>{highlight}</li>
                    ))}
                  </ul>
                </details>
              </li>
            ))}
          </ol>
        </section>
      )
    }
  </div>
</ListLayout>
