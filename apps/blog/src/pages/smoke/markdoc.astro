---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('posts', 'markdoc-smoke-test');
if (!entry) throw new Error('markdoc-smoke-test entry not found');
const { Content } = await render(entry);
---

<BaseLayout title="Markdoc 스모크 테스트">
  <main id="main-content" class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-2xl font-bold">{entry.data.title}</h1>
    <p class="text-muted mt-2 text-sm">{entry.data.description}</p>
    <hr class="my-8" />
    <Content />
  </main>
</BaseLayout>
