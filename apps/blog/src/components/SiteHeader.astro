---
/**
 * 사이트 공통 헤더 (NOR-16).
 *
 * 랜드마크(`header` > `nav`)를 제공하고, 현재 섹션에 `aria-current="page"` 를 준다.
 * 시각 디자인 확정은 NOR-24(베이스 테마) 몫이라 여기서는 최소한만 둔다.
 */
import ThemeToggle from './ThemeToggle.astro';
import SearchTrigger from './SearchTrigger.astro';
import { aboutPath, blogPagePath, homePath, portfolioPath, topicsPath } from '../lib/routes';
import { langFromPath, UI } from '../lib/i18n';
import BrandMark from './BrandMark.astro';

interface Props {
  /** 언어 전환 링크가 갈 곳(번역판). 없으면 다른 언어의 첫 화면이다(NOR-250). */
  languageSwitch?: string | undefined;
}

const lang = langFromPath(Astro.url.pathname);
const ui = UI[lang];
const otherLang = lang === 'ko' ? 'en' : 'ko';
const switchHref = Astro.props.languageSwitch ?? homePath(otherLang);

// 시리즈는 글에서 자연스럽게 이어지므로 상단에서 뺐다. 푸터에서 접근할 수 있다.
// 영어 페이지는 영어로 있는 곳만 둔다(분류 탐색은 한국어 글만 다룬다).
const NAV_ITEMS =
  lang === 'en'
    ? [{ href: blogPagePath(1, 'en'), label: ui.navBlog }]
    : [
        { href: '/blog', label: ui.navBlog },
        { href: aboutPath(), label: ui.navAbout },
        { href: portfolioPath(), label: ui.navPortfolio },
        { href: topicsPath(), label: ui.navTopics },
      ];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

/**
 * 정확히 그 페이지면 `page`, 그 아래 하위 경로면 `true`(현재 섹션).
 * 하위 글에서까지 `page` 를 주면 "지금 이 페이지"라는 뜻이 흐려진다.
 */
function currentState(href: string): 'page' | 'true' | undefined {
  if (pathname === href) return 'page';
  return pathname.startsWith(`${href}/`) ? 'true' : undefined;
}
---

<header class="border-border border-b">
  <div class="site-shell flex flex-wrap items-center gap-x-6 gap-y-2 py-4">
    <a href={homePath(lang)} class="site-brand">
      <span class="site-brand__mark"><BrandMark size={19} weight="bold" /></span>
      <span class="site-brand__word">NORU</span>
    </a>
    <nav aria-label={ui.mainNav}>
      <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a href={item.href} aria-current={currentState(item.href)} class="site-nav__link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    {/* 사이트 검색은 한국어 글만 색인한다(NOR-250). */}
    {lang === 'ko' && <SearchTrigger />}
    <a
      href={switchHref}
      hreflang={UI[otherLang].htmlLang}
      lang={UI[otherLang].htmlLang}
      class="site-nav__link text-sm"
    >
      {ui.switchLanguage}
    </a>
    <ThemeToggle />
  </div>
</header>
