---
/**
 * 시리즈 라벨 (NOR-241). 글 제목 위에 "시리즈 이름 · N편" 을 작은 eyebrow 로 보여 준다.
 *
 * 글 카드와 상세 헤더가 같은 컴포넌트를 써서 문구·스타일이 어긋나지 않는다. 이름은 시리즈 페이지로
 * 가는 링크다. 카드 전체를 링크로 감싸지 않으므로(PostCard) 중첩 링크가 생기지 않는다.
 * 편 번호는 `buildSeriesLabels` 가 `SeriesNav` 와 같은 규칙으로 구한 값이다.
 */
import type { SeriesLabel } from '../lib/series-nav';
import { seriesPath } from '../lib/routes';
import { langFromPath } from '../lib/i18n';

interface Props {
  label: SeriesLabel;
  /** 검색 결과에도 이 문구를 보여 주기 위해 Pagefind 메타(`series`)로 노출한다. 상세 헤더에서만 켠다. */
  pagefindMeta?: boolean;
}

const { label, pagefindMeta = false } = Astro.props;
// 시리즈 페이지는 한국어 글만 다룬다. 영어 페이지의 라벨은 링크 없이 보인다(NOR-250).
const english = langFromPath(Astro.url.pathname) === 'en';
---

<p class="series-label">
  <span class="sr-only">{english ? 'Series ' : '시리즈 '}</span><span
    data-pagefind-meta={pagefindMeta ? 'series' : undefined}
    >{
      english ? (
        <span class="series-label__link">{label.name}</span>
      ) : (
        <a href={seriesPath(label.slug)} class="series-label__link">
          {label.name}
        </a>
      )
    }{
      label.position !== undefined && (
        <span>{english ? ` · Part ${label.position}` : ` · ${label.position}편`}</span>
      )
    }</span
  >
</p>
