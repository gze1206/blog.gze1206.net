---
/**
 * 글 상세 본문 뒤의 댓글 영역 (NOR-200).
 *
 * 첫 화면에 외부 스크립트를 넣지 않는다. 영역이 화면에 가까워지면 Comentario 스크립트를 한 번만
 * 붙인다. 사이트 테마가 바뀌면(`themechange`) `theme` 속성을 바꾸고, Comentario 는 그 자리에서 다시 그린다.
 */
import { commentsEmbed } from '../lib/comments';
import { langFromPath, UI } from '../lib/i18n';

interface Props {
  slug: string;
  /** 댓글 묶음 경로(NOR-253). 번역판끼리 같은 값을 쓴다. 없으면 글 경로다. */
  threadPath?: string | undefined;
}

const lang = langFromPath(Astro.url.pathname);
const ui = UI[lang];
const embed = commentsEmbed(Astro.props.slug, lang, Astro.props.threadPath);
---

<section
  id="comments"
  aria-labelledby="comments-heading"
  class="border-border mt-12 border-t pt-8"
  data-comments-src={embed.scriptSrc}
  data-comments-integrity={embed.integrity}
>
  <h2 id="comments-heading" class="text-body text-lg font-semibold">{ui.comments}</h2>
  <p class="text-muted mt-1 text-sm">{ui.commentsHint}</p>
  <comentario-comments
    class="mt-4 block"
    page-id={embed.pageId}
    lang={embed.lang}
    theme="light"
    max-level="3"
    no-fonts="true"></comentario-comments>
  <noscript>
    <p class="text-muted text-sm">{ui.commentsNoScript}</p>
  </noscript>
</section>

<script>
  import { commentsTheme } from '../lib/comments';

  const section = document.querySelector<HTMLElement>('section#comments');
  const tag = section?.querySelector('comentario-comments');

  if (section && tag) {
    const syncTheme = () =>
      tag.setAttribute('theme', commentsTheme(document.documentElement.classList.contains('dark')));
    syncTheme();
    window.addEventListener('themechange', syncTheme);

    const src = section.dataset.commentsSrc;
    const integrity = section.dataset.commentsIntegrity;
    const load = () => {
      if (!src || !integrity || document.querySelector(`script[src="${src}"]`)) return;
      const script = document.createElement('script');
      // SRI 검사에는 CORS 요청이 필요하다. 서버는 블로그 Origin 에 ACAO 를 준다.
      script.integrity = integrity;
      script.crossOrigin = 'anonymous';
      script.src = src;
      script.defer = true;
      document.body.append(script);
    };
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            observer.disconnect();
            load();
          }
        },
        { rootMargin: '600px 0px' },
      );
      observer.observe(section);
    } else {
      load();
    }
  }
</script>
