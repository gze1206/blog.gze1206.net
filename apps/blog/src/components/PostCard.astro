---
/**
 * 목록용 글 카드 (NOR-16).
 *
 * a11y: 카드 전체를 링크로 감싸지 않고 **제목만 링크**로 둔다. 그래야 스크린리더의
 * 링크 목록에서 글 제목이 그대로 읽힌다("더 보기" 같은 맥락 없는 링크 텍스트를 만들지 않는다).
 * 카테고리·태그는 별도 링크라 카드 안에 링크가 여러 개지만, 각각 텍스트가 곧 목적지다.
 */
import type { Post } from '../lib/content';
import { formatKoreanDate, toISODate } from '../lib/date';
import { categoryPath, postPath, tagPath } from '../lib/routes';
import { toSlug } from '../lib/slug';

interface Props {
  post: Post;
  /** 카드 제목의 헤딩 레벨. 페이지의 헤딩 계층에 맞춰 호출부가 정한다. */
  headingLevel?: 2 | 3;
}

const { post, headingLevel = 2 } = Astro.props;
const { title, description, category, tags, publishedAt, draft } = post.data;
const Heading = `h${headingLevel}` as const;
---

<article
  class="border-border border-b py-6 last:border-b-0"
  data-draft={draft ? 'true' : undefined}
>
  <div class="text-muted flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
    <time datetime={toISODate(publishedAt)}>{formatKoreanDate(publishedAt)}</time>
    <a href={categoryPath(toSlug(category))} class="rounded hover:underline">{category}</a>
    {
      draft && (
        <span class="bg-notice text-notice-foreground rounded px-1.5 py-0.5 text-xs font-semibold">
          초안
        </span>
      )
    }
  </div>

  <Heading class="mt-2 text-xl font-bold sm:text-2xl">
    <a href={postPath(post.data.slug)} class="rounded hover:underline">{title}</a>
  </Heading>

  <p class="text-muted mt-2">{description}</p>

  <ul class="mt-3 flex flex-wrap gap-2" aria-label="태그">
    {
      tags.map((tag) => (
        <li>
          <a
            href={tagPath(toSlug(tag))}
            class="bg-surface-sunken text-body hover:bg-accent-soft inline-block rounded-full px-2.5 py-0.5 text-sm"
          >
            #{tag}
          </a>
        </li>
      ))
    }
  </ul>
</article>
