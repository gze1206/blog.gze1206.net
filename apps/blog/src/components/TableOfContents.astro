---
/**
 * 글 머리의 접이식 목차 (NOR-17, NOR-150, ADR 0010).
 *
 * - **JS 없는 정적 마크업**이다. 접기는 `<details>`, 이동은 브라우저 기본 프래그먼트다.
 * - 기본은 열린 상태다. 목차는 글을 읽기 전에 지형을 보는 장치라, 접혀 있으면 그 일을 못 한다.
 * - `entries` 가 비면 아무것도 렌더하지 않는다 — 판단은 `buildToc`/`resolveTocPlacement` 가 한다.
 * - 검색 색인에서는 뺀다. 본문 헤딩이 이미 색인되므로, 목차까지 넣으면 같은 문장이 두 번 잡힌다.
 */
import TocList from './TocList.astro';
import type { TocEntry } from '../lib/toc';

interface Props {
  entries: readonly TocEntry[];
}

const { entries } = Astro.props;
---

{
  entries.length > 0 && (
    <details class="post-toc" open data-post-toc data-pagefind-ignore>
      <summary class="post-toc__summary">이 글의 목차</summary>
      <nav aria-label="목차" class="post-toc__body">
        <TocList entries={entries} />
      </nav>
    </details>
  )
}
