---
/**
 * 목록 페이지네이션 (NOR-16).
 *
 * a11y: `<nav>` + `aria-label`, 현재 페이지에 `aria-current="page"`.
 * 현재 페이지는 링크가 아니라 `<span>` 이다 — 자기 자신으로 가는 링크는 노이즈다.
 */
import { blogPagePath } from '../lib/routes';
import { langFromPath, UI } from '../lib/i18n';

interface Props {
  currentPage: number;
  lastPage: number;
}

const { currentPage, lastPage } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const ui = UI[lang];
const pages = Array.from({ length: lastPage }, (_, index) => index + 1);
const linkClass =
  'inline-flex min-w-9 items-center justify-center rounded border border-border-strong px-3 py-1.5 text-sm hover:bg-surface-sunken';
---

{
  lastPage > 1 && (
    <nav aria-label={ui.pagination} class="mt-10">
      <ul class="flex flex-wrap items-center justify-center gap-2">
        {currentPage > 1 && (
          <li>
            <a href={blogPagePath(currentPage - 1, lang)} rel="prev" class={linkClass}>
              {ui.previousPage}
            </a>
          </li>
        )}
        {pages.map((pageNumber) =>
          pageNumber === currentPage ? (
            <li>
              <span
                aria-current="page"
                class="border-accent bg-accent text-accent-foreground inline-flex min-w-9 items-center justify-center rounded border px-3 py-1.5 text-sm font-semibold"
              >
                <span class="sr-only">현재 페이지, </span>
                {pageNumber}
              </span>
            </li>
          ) : (
            <li>
              <a href={blogPagePath(pageNumber, lang)} class={linkClass}>
                <span class="sr-only">페이지 </span>
                {pageNumber}
              </a>
            </li>
          ),
        )}
        {currentPage < lastPage && (
          <li>
            <a href={blogPagePath(currentPage + 1, lang)} rel="next" class={linkClass}>
              {ui.nextPage}
            </a>
          </li>
        )}
      </ul>
    </nav>
  )
}
