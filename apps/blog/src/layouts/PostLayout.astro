---
/**
 * 글 상세 레이아웃 (NOR-16, NOR-17).
 *
 * 헤딩 계층: 글 제목이 `h1`, 본문 헤딩은 `h2` 부터 쓰는 것을 전제로 한다.
 *
 * 파생 데이터(목차·읽기 시간·ISO 날짜)는 여기서 계산하지 않고 `derivePostDetail` 이 만든
 * {@link PostDetail} 을 받는다. 같은 값을 Phase 7(JSON-LD)이 다시 쓰기 때문이다 —
 * 표시용 계산을 템플릿에 묻어두면 구조화 데이터와 조용히 어긋난다. 읽기 시간을
 * `<time datetime="PT3M">` 으로 내보내는 것도 같은 이유다(JSON-LD `timeRequired` 와 같은 값).
 *
 * 메타(NOR-27)도 같은 원칙이다 — `og:type=article` 과 `article:published_time` /
 * `article:modified_time` 을 `BaseLayout` 에 넘기되, 시각은 {@link PostDetail} 의 ISO 값을
 * **재사용**한다. 화면은 `isUpdated` 가 false 면 수정일을 감추지만 OG 는 감추지 않는다 —
 * `updatedAt` 은 스키마 필수 필드라 항상 실재하고, 크롤러에게는 "발행일과 같음"이 더 정확한
 * 정보이기 때문이다(spec NOR-27 결정 7).
 *
 * 확장 지점: 본문 뒤 `<slot name="after-content">`. NOR-18 의 시리즈 내비게이션이 여기 들어온다.
 * 레이아웃은 그 안에 무엇이 오는지 알지 못한다 — 시리즈 내비게이션을 렌더할지 말지는
 * `buildSeriesNav`(ADR 0011)가 판단하고, 레이아웃은 자리만 내준다.
 */
import ReadTracker from '../components/ReadTracker.astro';
import BaseLayout from './BaseLayout.astro';
import katexCss from 'katex/dist/katex.min.css?url';
import TableOfContents from '../components/TableOfContents.astro';
import TocFab from '../components/TocFab.astro';
import { formatDate, readingLabel, UI } from '../lib/i18n';
import { categoryPath, postPath, tagPath } from '../lib/routes';
import { toSlug } from '../lib/slug';
import SeriesLabel from '../components/SeriesLabel.astro';
import { getSeriesLabels, getTranslation, type Post } from '../lib/content';
import type { PostDetail } from '../lib/post-detail';
import { buildArticleJsonLd, buildBreadcrumbJsonLd } from '../lib/json-ld';
import { resolveTocPlacement } from '../lib/toc';

interface Props {
  post: Post;
  /** 목차·읽기 시간·ISO 날짜. `derivePostDetail(...)` 의 결과를 그대로 넘긴다. */
  detail: PostDetail;
}

const { post, detail } = Astro.props;
const lang = post.data.lang;
const ui = UI[lang];
// 분류 페이지는 한국어 글만 다룬다. 영어 글의 카테고리·태그는 링크 없이 보인다(NOR-250).
const linkTaxonomy = lang === 'ko';
// 헤더의 소속 표시(NOR-241): 제목 위 라벨. 이전/다음·목록·진행도는 `SeriesNav` 가 그린다(NOR-18).
const seriesLabel = (await getSeriesLabels(lang)).get(post.data.slug);
// 번역판(NOR-250): 있으면 글 머리에 링크를 두고, 메타에 hreflang 대안을 낸다.
const translation = await getTranslation(post);
const translationPath =
  translation === undefined ? undefined : postPath(translation.data.slug, translation.data.lang);
// Markdown 의 rehype-katex 결과는 Markdoc 컴포넌트를 거치지 않는다.
const renderedContent = await Astro.slots.render('default');
const hasMath = /class=["'][^"']*\bkatex\b[^"']*["']/.test(renderedContent);
const { title, description, category, tags, publishedAt, updatedAt, draft } = post.data;
const { toc, readingTime, publishedISO, updatedISO, isUpdated } = detail;
const tocPlacement = resolveTocPlacement(post.data.toc, toc.length);
const site = 'https://gze1206.net';
const url = `${site}${postPath(post.data.slug, lang)}`;
const jsonLd = [
  {
    ...buildArticleJsonLd({
      title,
      description,
      url,
      published: publishedISO,
      modified: updatedISO,
    }),
    inLanguage: ui.htmlLang,
  },
  buildBreadcrumbJsonLd([
    { name: ui.home, url: `${site}${lang === 'en' ? '/en' : '/'}` },
    { name: ui.blogHeading, url: `${site}${lang === 'en' ? '/en/blog' : '/blog'}` },
    { name: title, url },
  ]),
];
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  article={{ publishedTime: publishedISO, modifiedTime: updatedISO }}
  jsonLd={jsonLd}
  alternates={translation === undefined || translationPath === undefined
    ? undefined
    : [{ lang: translation.data.lang, path: translationPath }]}
  languageSwitch={translationPath}
>
  {hasMath && <link rel="stylesheet" href={katexCss} />}
  <main id="main-content" class="article">
    {/* 사이트 검색은 한국어 글만 색인한다(NOR-250). */}
    <article data-pagefind-body={lang === 'ko' ? '' : undefined}>
      <header class="article__head">
        {
          draft && (
            <p class="bg-notice text-notice-foreground mb-5 inline-block rounded px-2 py-1 text-sm font-semibold">
              {lang === 'en'
                ? 'Draft — only visible on the dev server'
                : '초안 — 개발 서버에서만 보입니다'}
            </p>
          )
        }

        {
          translationPath !== undefined && translation !== undefined && (
            <p class="mb-4 text-sm">
              <a
                href={translationPath}
                hreflang={UI[translation.data.lang].htmlLang}
                lang={UI[translation.data.lang].htmlLang}
                class="text-accent underline"
              >
                {ui.readTranslation}
              </a>
            </p>
          )
        }

        <div class="article-taxonomy">
          <span class="article-taxonomy__label">{ui.category}</span>
          {
            linkTaxonomy ? (
              <a href={categoryPath(toSlug(category))} class="category-badge">
                {category}
              </a>
            ) : (
              <span class="category-badge">{category}</span>
            )
          }
        </div>

        {seriesLabel !== undefined && <SeriesLabel label={seriesLabel} pagefindMeta />}
        <h1 class="article__title">{title}</h1>
        <p class="article__summary">{description}</p>

        <div class="article__meta">
          <time datetime={publishedISO}>{formatDate(publishedAt, lang)}</time>
          {
            isUpdated && (
              <span>
                ({ui.updated} <time datetime={updatedISO}>{formatDate(updatedAt, lang)}</time>)
              </span>
            )
          }
          <span>
            {`${ui.readingTime} `}
            <time datetime={readingTime.iso}>{readingLabel(readingTime, lang)}</time>
          </span>
        </div>

        <div class="article-taxonomy">
          <span class="article-taxonomy__label" id="post-tags-label">{ui.tags}</span>
          <ul class="tag-chips" aria-labelledby="post-tags-label">
            {
              tags.map((tag) => (
                <li>
                  {linkTaxonomy ? (
                    <a href={tagPath(toSlug(tag))} class="tag-chip">
                      {tag}
                    </a>
                  ) : (
                    <span class="tag-chip">{tag}</span>
                  )}
                </li>
              ))
            }
          </ul>
        </div>
      </header>

      {tocPlacement.inline && <TableOfContents entries={toc} />}

      <div class="post-body article__body">
        <slot />
      </div>
      {/* 끝까지 읽음의 기준점(NOR-234). 스크립트는 본문 밖의 ReadTracker 에 있다. */}
      <div aria-hidden="true" data-read-sentinel data-reading-minutes={readingTime.minutes}></div>

      <div class="article__after">
        <slot name="after-content" />
      </div>
    </article>
    <ReadTracker />

    {
      tocPlacement.floating && (
        <TocFab entries={toc} followsScroll={tocPlacement.floatingFollowsScroll} />
      )
    }
  </main>
</BaseLayout>
